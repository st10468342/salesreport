private void btnProcessActionPerformed(java.awt.event.ActionEvent evt) {

    // Get values from the form
    String customerName = txtCustomer.getText();
    String product = cmbProduct.getSelectedItem().toString();
    double price = Double.parseDouble(txtPrice.getText());

    // Perform calculations
    double vat = calc.GetVat(price);
    double commission = calc.GetCommission(price);
    double total = calc.GetTotal(price);

    // Display results
    JOptionPane.showMessageDialog(this,
            "Customer Name: " + customerName
            + "\nProduct: " + product
            + "\nVAT: R " + vat
            + "\nCOMMISSION: R " + commission
            + "\nTOTAL: R " + total);

    // Save to data.txt
    try {
        FileWriter writer = new FileWriter("data.txt", true);

        writer.write("DATA LOG\n");
        writer.write("Customer Name: " + customerName + "\n");
        writer.write("Product: " + product + "\n");
        writer.write("VAT: R " + vat + "\n");
        writer.write("COMMISSION: R " + commission + "\n");
        writer.write("TOTAL: R " + total + "\n");
        writer.write("----------------------------------\n");

        writer.close();

    } catch (IOException e) {
        JOptionPane.showMessageDialog(this,
                "Error writing to file.");
    }
}

